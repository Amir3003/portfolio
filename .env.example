# Copy to .env.local and fill in. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle: only put public data there.

# --- Public: shown on the legal pages (leave a value empty to hide it) ---
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION_ID=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SITE_URL=

# --- Server only (never exposed to the browser) ---
# HTTPS URL that receives data requests as JSON (a Slack/Discord/Telegram relay or Formspree-style endpoint).
# While this is unset the data request form answers 503 instead of pretending to deliver.
DATA_REQUEST_WEBHOOK_URL=
